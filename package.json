{
  "name": "pi-switch",
  "version": "0.3.2",
  "description": "AI Agent Model Gateway & Provider Manager (pi extension)",
  "keywords": [
    "pi-package",
    "pi",
    "model-router",
    "provider-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XUHONGHAO/pi-switch.git"
  },
  "bugs": {
    "url": "https://github.com/XUHONGHAO/pi-switch/issues"
  },
  "homepage": "https://github.com/XUHONGHAO/pi-switch#readme",
  "files": [
    "src",
    "scripts/link-extension.ps1",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check",
    "dev": "pi -e ./src/index.ts",
    "link:ext": "powershell -ExecutionPolicy Bypass -File ./scripts/link-extension.ps1",
    "unlink:ext": "powershell -ExecutionPolicy Bypass -File ./scripts/link-extension.ps1 -Unlink"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
