{
  "openai_official": {
    "name": "OpenAI Official (Responses)",
    "authProvider": "openai",
    "type": "openai-responses",
    "api": "openai-responses",
    "baseUrl": "https://api.openai.com/v1",
    "enabled": true,
    "apiKey": "$OPENAI_API_KEY",
    "discoverModels": false,
    "models": [
      { "id": "gpt-5", "name": "GPT-5", "reasoning": true }
    ]
  },
  "anthropic_official": {
    "name": "Anthropic Official",
    "authProvider": "anthropic",
    "type": "anthropic",
    "api": "anthropic-messages",
    "baseUrl": "https://api.anthropic.com",
    "enabled": true,
    "apiKey": "$ANTHROPIC_API_KEY",
    "discoverModels": false,
    "models": [
      {
        "id": "claude-sonnet-4-5",
        "name": "Claude Sonnet",
        "reasoning": true,
        "thinkingLevelMap": { "off": null, "low": "low", "medium": "medium", "high": "high", "xhigh": null }
      }
    ]
  },
  "gemini_official": {
    "name": "Google Gemini",
    "type": "gemini",
    "api": "google-generative-ai",
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "enabled": true,
    "apiKey": "!secret-tool get gemini-key",
    "discoverModels": false,
    "models": [
      { "id": "gemini-2.5-pro", "name": "Gemini 2.5 Pro", "reasoning": true }
    ]
  },
  "sub2api": {
    "name": "sub2api",
    "type": "openai",
    "api": "openai-completions",
    "baseUrl": "http://127.0.0.1:6780/v1",
    "enabled": true,
    "apiKey": "$SUB2API_API_KEY",
    "discoverModels": true,
    "modelInclude": ["gpt-*", "claude-*"],
    "modelExclude": ["*-embedding-*", "*-tts", "*-image*"],
    "modelDefaults": { "contextWindow": 200000, "maxTokens": 16384 }
  }
}
